// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "bindings": {
      "ctrl-a k": "workspace::ToggleZoom",
    },
  },
  {
    "unbind": {
      "shift-escape": "workspace::ToggleZoom",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-a t": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-s": "workspace::Save",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-s": "workspace::Save",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-s": ["workspace::SendKeystrokes", "escape ctrl-s"],
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space l": "pane::ActivateNextItem",
      "space h": "pane::ActivatePreviousItem",
    },
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "space h": "editor::SelectAllMatches",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "ctrl-a f": "pane::DeploySearch",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-a d": "pane::CloseActiveItem",
    },
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "s": "vim::HelixJumpToWord",
    },
  },
]
