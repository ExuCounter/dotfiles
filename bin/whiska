#!/usr/bin/env python3
"""whiska spawn <branch> <task> [-- <claude args>], run from a terminal of the Herdr
app: a fresh worktree at <main>/worktrees/<branch>, cut from the branch the main
checkout is on, with a mouse working in it as a space of the app.

Everything else, and spawn outside the app ($HC_TERMINAL_ID unset), goes to the
Elixir whiska in ~/.local/bin. The rules are Whiska's lib/whiska/spawn.ex; the brief
is its priv/brief.md ($WHISKA_SRC, default ~/Desktop/projects/whiska).

Everything that can be refused is refused before the worktree is made.
"""

import json
import os
import re
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
ELIXIR = os.path.join(HOME, ".local", "bin", "whiska")
SRC = os.environ.get("WHISKA_SRC") or os.path.join(HOME, "Desktop", "projects", "whiska")

USAGE = "expected whiska spawn <branch> <task> [-- <claude args>]."

# herdr names an agent `[a-z][a-z0-9_-]{0,31}`; the agent is named for the branch.
BRANCH = re.compile(r"[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*\Z")
LONGEST = 32

# The core types the task as a bracketed paste, which a control character could
# end early, reaching Claude Code as keystrokes.
UNTYPEABLE = re.compile("[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f]")

# Folders cloned beside a marker, when the lock files match and git ignores them.
MARKERS = [
    ("mix.exs", ["mix.lock"], ["deps", "_build"]),
    ("package.json", ["package-lock.json", "yarn.lock", "pnpm-lock.yaml"], ["node_modules"]),
]


class Refused(Exception):
    pass


def git(cwd, *args):
    done = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else None


def main(args):
    if not args or args[0] != "spawn" or not os.environ.get("HC_TERMINAL_ID"):
        os.execv(ELIXIR, [ELIXIR, *args])
    try:
        print(spawn(os.getcwd(), args[1:]))
    except Refused as why:
        print(f"whiska: {why}", file=sys.stderr)
        sys.exit(1)


def spawn(cwd, args):
    own, claude_args = (args[: args.index("--")], args[args.index("--") + 1 :]) if "--" in args else (args, [])
    if len(own) != 2:
        raise Refused(USAGE)
    branch, text = own
    plain_branch(branch)
    main = main_checkout(cwd)
    trusted(main)
    path = os.path.join(main, "worktrees", branch)
    free(main, branch, path)
    task = clean(text)
    brief = read_brief()
    hide_worktrees(main)
    base = git(main, "symbolic-ref", "--quiet", "--short", "HEAD")
    create(main, branch, base, path)
    return start(main, path, branch, base, task, brief, claude_args)


def plain_branch(branch):
    if not BRANCH.match(branch):
        raise Refused(
            f"{json.dumps(branch)} is not a branch name spawn takes: lowercase letters, digits, "
            "- and /, starting with a letter."
        )
    if len(branch) > LONGEST:
        raise Refused(f"{branch} is longer than the {LONGEST} characters herdr takes in a branch's agent name.")


def main_checkout(cwd):
    common = git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if common is None:
        raise Refused(f"{cwd} is not in a git repo.")
    return os.path.dirname(common)


# Claude asks whether to trust a folder it has never opened, and a mouse stopped at
# that question takes no task. A worktree inherits the trust of the repo it sits in.
def trusted(main):
    try:
        with open(os.path.join(HOME, ".claude.json")) as f:
            projects = json.load(f).get("projects")
    except (OSError, ValueError, AttributeError):
        return
    if not isinstance(projects, dict):
        return
    path = main
    while True:
        project = projects.get(path)
        if isinstance(project, dict) and project.get("hasTrustDialogAccepted") is True:
            return
        if path == os.path.dirname(path):
            break
        path = os.path.dirname(path)
    raise Refused(
        f"Claude has not been trusted in {main}, so the mouse would stop at its trust "
        "question. Run `claude` there once and answer it, then spawn again."
    )


def free(main, branch, path):
    if git(main, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}") is not None:
        raise Refused(f"{branch} already exists. Every task gets a fresh branch; name another.")
    if os.path.lexists(path):
        raise Refused(f"{path} is already there. Name another branch.")


def clean(text):
    if UNTYPEABLE.search(text):
        raise Refused("the task holds a control character.")
    if not text.strip():
        raise Refused("the task is empty: say what the mouse should do.")
    return re.sub(r"\r\n?", "\n", text).strip()


def read_brief():
    try:
        with open(os.path.join(SRC, "priv", "brief.md")) as f:
            return f.read()
    except OSError as error:
        raise Refused(f"could not read Whiska's brief ({error}); set WHISKA_SRC to Whiska's checkout.")


def hide_worktrees(main):
    if git(main, "check-ignore", "-q", "worktrees/") is not None:
        return
    common = git(main, "rev-parse", "--path-format=absolute", "--git-common-dir")
    exclude = os.path.join(common, "info", "exclude")
    os.makedirs(os.path.dirname(exclude), exist_ok=True)
    with open(exclude, "a") as f:
        f.write("/worktrees/\n")


def create(main, branch, base, path):
    done = subprocess.run(
        ["git", "-C", main, "worktree", "add", "-q", "-b", branch, path, base or "HEAD"],
        capture_output=True,
        text=True,
    )
    if done.returncode != 0:
        raise Refused(f"git could not create the worktree ({done.stderr.strip()}).")


def start(main, path, branch, base, task, brief, claude_args):
    cloned = clone(main, path)
    try:
        brief_path = write_brief(brief)
        # A question asked through AskUserQuestion ends no turn, so the Stop hook
        # never reports it; a mouse asks in its report instead.
        argv = [
            "claude", "--name", branch, "--dangerously-skip-permissions",
            "--disallowedTools", "AskUserQuestion", "--append-system-prompt-file", brief_path,
            *claude_args,
        ]
        cut = f"Your branch {branch} was cut from {base}.\n\n" if base else ""
        space = json.dumps({"name": branch, "folder": path, "argv": argv, "task": f"{cut}Your task:\n\n{task}"})
        made = run(["herdr-app", "do", "space.new", space])
        terminal = json.loads(made)["terminal"]
    except (Failed, OSError, ValueError, KeyError, TypeError) as why:
        raise Refused(
            f"{branch}'s worktree is at {path}, but its mouse did not start: {why}. "
            f"Start Claude there by hand, or remove it with `git worktree remove {path}`."
        )
    try:
        run(["hc", "label", terminal, f"whiska.branch={branch}", f"whiska.base={base or ''}", f"whiska.main={main}"])
    except (Failed, OSError) as why:
        raise Refused(
            f"{branch} is working in {terminal} at {path}, but its terminal is not labelled: {why}. "
            f"Label it with `hc label {terminal} whiska.branch={branch} whiska.base={base or ''} whiska.main={main}`."
        )
    return f"Spawned {branch} in worktrees/{branch}; {cloned}."


class Failed(Exception):
    pass


def run(argv):
    done = subprocess.run(argv, capture_output=True, text=True)
    if done.returncode != 0:
        raise Failed(f"{argv[0]} {argv[1]} failed: {(done.stderr or done.stdout).strip()}")
    return done.stdout


def write_brief(brief):
    path = os.path.join(HOME, ".whiska", "brief.md")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(brief)
    return path


# Stocks the worktree with the main checkout's dependencies, copy-on-write, only when
# its lock file equals the main checkout's and git ignores the folder there, so a
# copy is never a change to commit. A clone never fails the spawn: what went wrong is
# the line it answers.
def clone(main, worktree):
    started = time.monotonic()
    cloned, skipped = [], []
    try:
        for marker, locks, folders in MARKERS:
            if not os.path.isfile(os.path.join(main, marker)):
                continue
            why = differs(main, worktree, locks)
            if why:
                skipped.append(f"{', '.join(folders)} not cloned: {why}")
            else:
                cloned += [folder for folder in folders if copy(main, worktree, folder)]
    except OSError as error:
        return f"could not clone ({error})"
    if cloned:
        took = f"{time.monotonic() - started:.1f}s"
        return "; ".join([f"cloned {', '.join(cloned)} in {took}", *skipped])
    return "; ".join(skipped) or "nothing to clone"


def differs(main, worktree, locks):
    lock = next((lock for lock in locks if os.path.isfile(os.path.join(main, lock))), None)
    if lock is None:
        return "the main checkout has no lockfile"
    if read(os.path.join(main, lock)) != read(os.path.join(worktree, lock)):
        return f"{lock} differs from the main checkout's"
    return None


def read(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except OSError:
        return None


def copy(main, worktree, folder):
    source, target = os.path.join(main, folder), os.path.join(worktree, folder)
    if not os.path.isdir(source) or os.path.lexists(target):
        return False
    if git(worktree, "check-ignore", "-q", folder + "/") is None:
        return False
    for flags in (["-c", "-R"], ["-R"]):
        if subprocess.run(["cp", *flags, source, target], capture_output=True).returncode == 0:
            return True
        subprocess.run(["rm", "-rf", target])
    return False


if __name__ == "__main__":
    main(sys.argv[1:])
