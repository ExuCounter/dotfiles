# This is Git's per-user configuration file.
[user]
name = Vova Potiichuk

[core]
	excludesFile = ~/.gitignore_global
[merge]
	tool = vimdiff
	conflictStyle = diff3
[mergetool]
	prompt = false
[url "git@github.com:"]
	insteadOf = https://github.com/
# Work email and the machine's TLS settings, kept out of this repository.
[include]
	path = ~/.gitconfig.local
